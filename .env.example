# Copie este arquivo para .env e preencha os valores abaixo.
# Nunca compartilhe nem versione o arquivo .env.

# Login do usuário ou organização proprietária dos Projects V2
GITHUB_OWNER=SEU_USUARIO_OU_ORGANIZACAO

# URL HTTPS pública e canônica deste servidor, sem barra final.
PUBLIC_URL=https://SEU-DOMINIO

# GitHub OAuth App: https://github.com/settings/developers
GITHUB_OAUTH_CLIENT_ID=COLE_O_CLIENT_ID
GITHUB_OAUTH_CLIENT_SECRET=COLE_O_CLIENT_SECRET

# Logins GitHub autorizados, separados por vírgula.
OAUTH_ALLOWED_GITHUB_USERS=jaison

# Gere com: openssl rand -hex 32
OAUTH_SIGNING_SECRET=COLE_UM_SEGREDO_ALEATORIO_DE_64_CARACTERES

# Monte um volume persistente no Easypanel em /data.
OAUTH_DATA_FILE=/data/oauth-state.json

PORT=80
