# Copie este arquivo para .env e preencha os valores abaixo.
# Nunca compartilhe nem versione o arquivo .env.

# GitHub fine-grained Personal Access Token
# Permissão necessária: Projects -> Read and write
GITHUB_TOKEN=github_pat_COLE_SEU_TOKEN_AQUI

# Segredo exclusivo para autenticar chamadas ao endpoint MCP.
# Gere um valor forte, por exemplo: openssl rand -hex 32
MCP_ACCESS_TOKEN=COLE_UM_SEGREDO_ALEATORIO_LONGO_AQUI

# Login do usuário ou organização proprietária dos Projects V2
GITHUB_OWNER=SEU_USUARIO_OU_ORGANIZACAO

# Porta interna do serviço (mantenha 3000 no Easypanel)
PORT=3000
